# Public Supabase values. The anon key is meant for the browser; row security limits it.
# Never put the service_role key here. Copy this file to .env for local use.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 1 opens the book without login. Empty brings the sign-in screen back.
EXPO_PUBLIC_SUPABASE_PUBLIC=1
